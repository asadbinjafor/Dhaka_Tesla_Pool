# Native backend only. Fresh checkout: copy to .env; retain existing secrets.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=dhaka_tesla_pool
DATABASE_USER=dtp
DATABASE_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DATABASE_SSL=false
# Schema changes use numbered migrations; startup never synchronizes/reset tables.
DATABASE_SYNCHRONIZE=false
# Optional legacy/hosting alternative; DATABASE_URL takes precedence when supplied.
# DATABASE_URL=postgresql://dtp:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/dhaka_tesla_pool
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_SECURE=false
# Explicit named seed only; never automatically seed/reset on startup.
DEMO_PASSWORD=replace-with-your-own-12-to-128-character-password
# ENABLE_DEMO_SEED=1
