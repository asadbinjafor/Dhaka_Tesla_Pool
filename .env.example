# Examples only. No real credentials are supplied or committed.
# Copy to .env for Docker and replace the password with a generated local secret.
POSTGRES_USER=dtp
POSTGRES_DB=dhaka_tesla_pool
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_ALPHANUMERIC_SECRET
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_SECURE=false
DEMO_PASSWORD=replace-with-your-own-12-to-128-character-password
# ENABLE_DEMO_SEED=1 only when explicitly running the demo seed CLI/profile
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
# Native API: set your own connection URI, percent-encoding reserved characters.
# DATABASE_URL=postgresql://dtp:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/dhaka_tesla_pool
